{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "replicaCount": {"type": "integer", "minimum": 1},
    "image": {"type": "object", "required": ["repository"], "properties": {"repository": {"type": "string", "minLength": 1}, "tag": {"type": "string"}, "pullPolicy": {"enum": ["Always", "IfNotPresent", "Never"]}}},
    "config": {"type": "object", "additionalProperties": {"type": ["string", "number", "boolean"]}},
    "database": {"type": "object", "properties": {"port": {"type": "integer", "minimum": 1, "maximum": 65535}, "sslmode": {"enum": ["disable", "allow", "prefer", "require", "verify-ca", "verify-full"]}}},
    "smtp": {"type": "object", "properties": {"tls": {"enum": ["none", "starttls", "tls"]}, "port": {"type": "integer"}}},
    "blobs": {"type": "object", "properties": {"backend": {"enum": ["fs", "s3"]}, "persistence": {"type": "object", "properties": {"accessMode": {"enum": ["ReadWriteOnce", "ReadWriteMany", "ReadOnlyMany", "ReadWriteOncePod"]}}}}},
    "service": {"type": "object", "properties": {"type": {"enum": ["ClusterIP", "NodePort", "LoadBalancer"]}, "port": {"type": "integer"}}},
    "terminationGracePeriodSeconds": {"type": "integer", "minimum": 1}
  }
}
